<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Win32_to_IntuneUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Win32_to_IntuneUI.Views.IntuneUploadDialog"
        Title="Upload to Microsoft Intune"
        Width="1000" Height="600"
        WindowStartupLocation="CenterOwner"
        x:DataType="vm:IntuneUploadViewModel">

    <Window.Styles>
        <!-- Button Styles with hover and pressed effects -->
        <Style Selector="Button.blue">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.blue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2980B9"/>
        </Style>
        <Style Selector="Button.blue:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#21618C"/>
        </Style>

        <Style Selector="Button.green">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#229954"/>
        </Style>
        <Style Selector="Button.green:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E8449"/>
        </Style>

        <Style Selector="Button.gray">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.gray:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7F8C8D"/>
        </Style>
        <Style Selector="Button.gray:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#5D6D7E"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Upload Packages to Microsoft Intune" 
                       FontSize="20" 
                       FontWeight="Bold"/>
            <TextBlock Text="Review and edit application names before uploading to Intune"
                       Foreground="Gray"/>
            
            <!-- Authentication Section -->
            <Border BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="15"
                    Margin="0,10,0,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Microsoft Graph Authentication" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Enter your Azure AD App Registration credentials to authenticate with Microsoft Graph."
                               Foreground="Gray"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    
                    <!-- Tenant ID -->
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" 
                                   Text="Tenant ID:" 
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding TenantId}"
                                 Watermark="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                    </Grid>
                    
                    <!-- Client ID -->
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" 
                                   Text="Client ID:" 
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding ClientId}"
                                 Watermark="Application (client) ID from Azure AD"/>
                    </Grid>
                    
                    <!-- Client Secret -->
                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" 
                                   Text="Client Secret:" 
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding ClientSecret}"
                                 Watermark="Client secret value"
                                 PasswordChar="•"/>
                        <Button Grid.Column="2"
                                Content="Connect"
                                Classes="blue"
                                Command="{Binding TestGraphConnectionCommand}"
                                Width="100"/>
                    </Grid>
                    
                    <TextBlock Text="{Binding GraphConnectionStatus}"
                               Foreground="{Binding GraphConnectionStatusColor}"
                               IsVisible="{Binding !!GraphConnectionStatus}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
                <!-- Selection Controls -->
                <Border Grid.Row="0"
                        Background="#F8F9FA"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Select All"
                                Classes="gray"
                                Command="{Binding SelectAllUploadCandidatesCommand}"
                                Width="100"/>
                        <Button Content="Deselect All"
                                Classes="gray"
                                Command="{Binding DeselectAllUploadCandidatesCommand}"
                                Width="100"/>
                        <TextBlock Text="{Binding UploadSelectionCount}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
                
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding UploadCandidates}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="All"
                      IsReadOnly="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto">
                
                <DataGrid.Columns>
                    <!-- Checkbox for Selection -->
                    <DataGridCheckBoxColumn Header="Upload"
                                            Binding="{Binding IsSelected}"
                                            Width="60"
                                            IsReadOnly="False"/>
                    
                    <!-- Application Name (Editable) -->
                    <DataGridTextColumn Header="Application Name"
                                        Binding="{Binding DisplayName}"
                                        Width="180"
                                        IsReadOnly="False"/>
                    
                    <!-- Install Command (Editable) -->
                    <DataGridTextColumn Header="Install Command"
                                        Binding="{Binding InstallCommand}"
                                        Width="200"
                                        IsReadOnly="False"/>
                    
                    <!-- Uninstall Command (Editable) -->
                    <DataGridTextColumn Header="Uninstall Command"
                                        Binding="{Binding UninstallCommand}"
                                        Width="200"
                                        IsReadOnly="False"/>
                    
                    <!-- Publisher (Editable) -->
                    <DataGridTextColumn Header="Publisher"
                                        Binding="{Binding Publisher}"
                                        Width="120"
                                        IsReadOnly="False"/>
                    
                    <!-- Description (Editable) -->
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="150"
                                        IsReadOnly="False"/>
                    
                    <!-- Package File -->
                    <DataGridTextColumn Header="Package File"
                                        Binding="{Binding PackageFileName}"
                                        Width="150"
                                        IsReadOnly="True"/>
                    
                    <!-- File Size -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding PackageFileSizeFormatted}"
                                        Width="80"
                                        IsReadOnly="True"/>
                    
                    <!-- Status -->
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding UploadStatus}"
                                        Width="100"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- Progress Section -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsProgressVisible}"
                Background="#F0F4F8"
                BorderBrush="#3498DB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,15,0,0">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProgressText}"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <!-- Spinning indicator -->
                        <Border Width="16" Height="16" 
                                Background="#3498DB" 
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform/>
                            </Border.RenderTransform>
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="Infinite">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="Opacity" Value="1"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="50%">
                                                <Setter Property="Opacity" Value="0.3"/>
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="Opacity" Value="1"/>
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                        </Border>
                        <TextBlock Text="Processing..." Foreground="#7F8C8D" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Minimum="0" 
                             Maximum="{Binding ProgressTotal}" 
                             Value="{Binding ProgressCurrent}"
                             Height="8"
                             Foreground="#3498DB"
                             Background="#E8E8E8"/>
            </StackPanel>
        </Border>

        <!-- Completion Banner -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsUploadComplete}"
                Background="{Binding CompletionBannerBackground}"
                BorderBrush="{Binding CompletionBannerBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,15,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding CompletionIcon}"
                           FontSize="24"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompletionTitle}"
                               FontWeight="Bold"
                               FontSize="14"/>
                    <TextBlock Text="{Binding CompletionMessage}"
                               Foreground="#5D6D7E"
                               FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="Dismiss"
                        Classes="gray"
                        Command="{Binding DismissCompletionCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10" 
                    Margin="0,20,0,0">
            <TextBlock Text="{Binding UploadStatusText}"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"
                       FontWeight="SemiBold"/>
            <Button Content="Show Log"
                    Classes="gray"
                    Command="{Binding ShowUploadLogCommand}"
                    Width="100"/>
            <Button Content="Cancel"
                    Classes="gray"
                    Click="CancelButton_Click"
                    Width="120"/>
            <Button Content="Start Upload"
                    Classes="green"
                    Command="{Binding StartIntuneUploadCommand}"
                    IsEnabled="{Binding !IsProcessing}"
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window>
