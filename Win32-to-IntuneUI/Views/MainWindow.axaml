<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Win32_to_IntuneUI.ViewModels"
        xmlns:local="using:Win32_to_IntuneUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Win32_to_IntuneUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Win32 to Intune Package Creator"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Blue Button Style -->
        <Style Selector="Button.blue">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.blue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2980B9"/>
        </Style>
        <Style Selector="Button.blue:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#21618C"/>
        </Style>

        <!-- Green Button Style -->
        <Style Selector="Button.green">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#229954"/>
        </Style>
        <Style Selector="Button.green:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E8449"/>
        </Style>

        <!-- Orange Button Style -->
        <Style Selector="Button.orange">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.orange:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D35400"/>
        </Style>
        <Style Selector="Button.orange:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#BA4A00"/>
        </Style>

        <!-- TabItem Header Style -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#F5F5F5" 
                Padding="20" 
                CornerRadius="8"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Win32 to Intune Package Creator" 
                                   FontSize="24" 
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding AppVersion}" 
                                   FontSize="12" 
                                   Foreground="#95A5A6"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,4"/>
                    </StackPanel>
                    <TextBlock Text="Create .intunewin packages for Microsoft Intune deployment" 
                               FontSize="14" 
                               Foreground="#7F8C8D"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{Binding SinglePackage.ToolStatus}" 
                               FontSize="12" 
                               FontWeight="Medium"
                               HorizontalAlignment="Right"/>
                    <!-- Update notification -->
                    <StackPanel Orientation="Horizontal" 
                                Spacing="8" 
                                IsVisible="{Binding IsUpdateAvailable}"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UpdateStatus}" 
                                   FontSize="11" 
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"/>
                        <Button Content="Restart"
                                Command="{Binding ApplyUpdateCommand}"
                                Classes="green"
                                FontSize="11"
                                Padding="8,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" 
                                Spacing="5"
                                IsVisible="{Binding !IsUpdateAvailable}"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{Binding UpdateStatus}" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"
                                   VerticalAlignment="Center"/>
                        <Button Content="[i]"
                                Command="{Binding ShowUpdateErrorCommand}"
                                IsVisible="{Binding HasUpdateError}"
                                FontSize="9"
                                Padding="4,1"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#3498DB"
                                Cursor="Hand"
                                ToolTip.Tip="Click for error details"/>
                        <TextBlock Text="✓"
                                   IsVisible="{Binding UpdateCheckSuccess}"
                                   FontSize="12"
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Up to date"/>
                        <TextBlock Text="✗"
                                   IsVisible="{Binding UpdateCheckFailed}"
                                   FontSize="12"
                                   Foreground="#E74C3C"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Update check failed"/>
                        <Button Content="Check"
                                Command="{Binding CheckForUpdatesCommand}"
                                FontSize="9"
                                Padding="4,1"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#3498DB"
                                Cursor="Hand"
                                ToolTip.Tip="Check for updates"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    Padding="0">
            
            <!-- Single Package Tab -->
            <TabItem Header="Single Package">
                <Grid RowDefinitions="*,Auto" DataContext="{Binding SinglePackage}">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="20">
                
                            <!-- Source Folder Section -->
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Source Folder *" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="The folder containing all your application files" 
                                               FontSize="12" 
                                               Foreground="#7F8C8D"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding SourceFolder}"
                                                 Watermark="Select source folder..."
                                                 Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" 
                                                Content="Browse..."
                                                Command="{Binding BrowseSourceFolderCommand}"
                                                Width="100"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Setup File Section -->
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Setup File *" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="The installer executable (e.g., setup.exe, install.msi)" 
                                               FontSize="12" 
                                               Foreground="#7F8C8D"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding SetupFile}"
                                                 Watermark="Select setup file..."
                                                 Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" 
                                                Content="Browse..."
                                                Command="{Binding BrowseSetupFileCommand}"
                                                Width="100"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Output Folder Section -->
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Output Folder *" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="Where the .intunewin package will be saved" 
                                               FontSize="12" 
                                               Foreground="#7F8C8D"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding OutputFolder}"
                                                 Watermark="Select output folder..."
                                                 Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" 
                                                Content="Browse..."
                                                Command="{Binding BrowseOutputFolderCommand}"
                                                Width="100"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Progress Section -->
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="20"
                                    IsVisible="{Binding IsProgressVisible}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Progress" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"
                                               Foreground="#2C3E50"/>
                                    <ProgressBar Value="{Binding ProgressValue}" 
                                                 Height="8"
                                                 Foreground="#3498DB"
                                                 Background="#E0E0E0"
                                                 Minimum="0" 
                                                 Maximum="100"
                                                 IsIndeterminate="{Binding IsPackaging}"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons for Single Mode -->
                    <Border Grid.Row="1" 
                            Background="#F5F5F5" 
                            Padding="20" 
                            CornerRadius="8"
                            Margin="0,20,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="* Required fields" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <Button Grid.Column="1" 
                                    Content="Upload to Intune"
                                    Classes="green"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UploadToIntuneCommand}"
                                    FontWeight="SemiBold"
                                    Padding="24,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" 
                                    Content="Create Package"
                                    Classes="blue"
                                    Command="{Binding CreatePackageCommand}"
                                    FontWeight="SemiBold"
                                    Padding="24,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    IsEnabled="{Binding !IsProcessing}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- Batch Processing Tab -->
            <TabItem Header="Batch Processing">
                <Grid RowDefinitions="*,Auto" DataContext="{Binding BatchProcessing}">
                <ScrollViewer Grid.Row="0">
                <StackPanel Spacing="20">
                    
                    <!-- Instructions -->
                    <Border Background="#E8F4F8" 
                            BorderBrush="#3498DB" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Batch Processing Workflow:" 
                                       FontWeight="SemiBold" 
                                       FontSize="13"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="• Select the parent folder containing your application subfolders" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="• Click 'Scan Folders' to review detected applications" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="• Select installers for items that need attention or skip them" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="• Select the output folder where packages will be saved" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="• Click 'Process Batch' to create all packages" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Batch Folder Selection -->
                    <Border Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Parent Folder *" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Select a folder containing subfolders with applications to package" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"/>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding BatchParentFolder}"
                                         Watermark="Select parent folder containing app subfolders..."
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..."
                                        Command="{Binding BrowseBatchFolderCommand}"
                                        Width="100"
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="2" 
                                        Content="Scan Folders"
                                        Classes="green"
                                        Command="{Binding ScanBatchFoldersCommand}"
                                        FontWeight="SemiBold"
                                        Width="120"
                                        IsEnabled="{Binding !IsProcessing}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Batch Output Folder -->
                    <Border Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output Folder *" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Where all .intunewin packages will be saved" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding BatchOutputFolder}"
                                         Watermark="Select output folder for batch packages..."
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..."
                                        Command="{Binding BrowseBatchOutputFolderCommand}"
                                        Width="100"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Batch Progress Section -->
                    <Border Background="#F5F5F5" 
                            CornerRadius="8" 
                            Padding="15"
                            IsVisible="{Binding IsProgressVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding ProgressText}"
                                       FontWeight="SemiBold" 
                                       FontSize="13"
                                       Foreground="#2C3E50"/>
                            <ProgressBar Value="{Binding ProgressCurrent}" 
                                         Minimum="0"
                                         Maximum="{Binding ProgressTotal, FallbackValue=100}"
                                         Height="8"
                                         Foreground="#E67E22"
                                         Background="#E0E0E0"
                                         IsIndeterminate="{Binding IsProcessingBatch}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                    <!-- Batch Action Buttons -->
                    <Border Grid.Row="1" 
                            Background="#F5F5F5" 
                            Padding="20" 
                            CornerRadius="8"
                            Margin="0,20,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding BatchStatusText}" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <Button Grid.Column="1" 
                                    Content="Upload to Intune"
                                    Classes="green"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UploadToIntuneCommand}"
                                    FontWeight="SemiBold"
                                    Padding="24,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="2" 
                                    Content="Process Batch"
                                    Classes="orange"
                                    Command="{Binding ProcessBatchCommand}"
                                    FontWeight="SemiBold"
                                    Padding="24,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    IsEnabled="{Binding !IsProcessing}"/>
                        </Grid>
                    </Border>
                    
                </Grid>
            </TabItem>

            <!-- Upload to Intune Tab -->
            <TabItem Header="Upload to Intune">
                <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding IntuneUpload}" Margin="0,10,0,0">
                    
                    <!-- Authentication Section -->
                    <Border Grid.Row="0"
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20"
                            Margin="0,0,0,15">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Microsoft Graph Authentication" 
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Enter your Azure AD App Registration credentials to authenticate with Microsoft Graph."
                                       Foreground="#7F8C8D"
                                       FontSize="12"/>
                            
                            <!-- Credentials Grid -->
                            <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tenant ID:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TenantId}" Watermark="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientId}" Watermark="Application (client) ID"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Client Secret:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClientSecret}" Watermark="Client secret value" PasswordChar="•"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="Connect" Classes="blue" Command="{Binding TestGraphConnectionCommand}" Width="100"/>
                            </Grid>
                            
                            <TextBlock Text="{Binding GraphConnectionStatus}"
                                       Foreground="{Binding GraphConnectionStatusColor}"
                                       IsVisible="{Binding !!GraphConnectionStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- Package List -->
                    <Border Grid.Row="1"
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Toolbar -->
                            <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Add Packages..." Classes="blue" Command="{Binding BrowseForPackagesCommand}" Width="120"/>
                                    <Button Content="Select All" Classes="gray" Command="{Binding SelectAllUploadCandidatesCommand}" Width="100"/>
                                    <Button Content="Deselect All" Classes="gray" Command="{Binding DeselectAllUploadCandidatesCommand}" Width="100"/>
                                    <TextBlock Text="{Binding UploadSelectionCount}" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- DataGrid -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding UploadCandidates}"
                                      AutoGenerateColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40"/>
                                    <DataGridTextColumn Header="Application Name" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridTextColumn Header="Install Command" Binding="{Binding InstallCommand}" Width="2*"/>
                                    <DataGridTextColumn Header="Uninstall Command" Binding="{Binding UninstallCommand}" Width="2*"/>
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Edit"
                                                        Click="EditPackageDetails_Click"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        ToolTip.Tip="Edit all package details"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding UploadStatus}" Width="120" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Action Bar -->
                    <Border Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Spacing="12">
                            <!-- Progress Section -->
                            <Border Background="#F5F5F5" 
                                    CornerRadius="8" 
                                    Padding="15"
                                    IsVisible="{Binding IsProgressVisible}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding ProgressText}"
                                               FontWeight="SemiBold" 
                                               FontSize="13"
                                               Foreground="#2C3E50"/>
                                    <ProgressBar Minimum="0" 
                                                 Maximum="{Binding ProgressTotal, FallbackValue=100}" 
                                                 Value="{Binding ProgressCurrent}"
                                                 Height="8"
                                                 Foreground="#3498DB"
                                                 Background="#E0E0E0"
                                                 IsIndeterminate="{Binding IsUploading}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Buttons Row -->
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding UploadStatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="Show Log" Classes="gray" Command="{Binding ShowUploadLogCommand}" Width="100" Margin="0,0,10,0"/>
                                <Button Grid.Column="2" Content="Start Upload" Classes="green" Command="{Binding StartIntuneUploadCommand}" Width="120" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <Grid RowDefinitions="*,Auto" Margin="20">
                    
                    <!-- Log Viewer -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="Application Log" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding Settings.LogOutput}" 
                                         IsReadOnly="True" 
                                         FontFamily="Consolas,Menlo,Monaco,monospace" 
                                         FontSize="11"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Grid.Row="1" Margin="0,15,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Logs from all tabs are consolidated here" VerticalAlignment="Center" Foreground="#666666"/>
                            <Button Grid.Column="1" Content="Clear Log" Classes="gray" Command="{Binding Settings.ClearLogCommand}" Width="100" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="Export Log" Classes="green" Command="{Binding Settings.ExportLogCommand}" Width="100"/>
                        </Grid>
                    </Border>
                    
                </Grid>
            </TabItem>
            
        </TabControl>
        
    </Grid>

</Window>
