<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Win32_to_IntuneUI.ViewModels"
        xmlns:local="using:Win32_to_IntuneUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Win32_to_IntuneUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Win32 to Intune Package Creator"
        Width="900" Height="700"
        MinWidth="800" MinHeight="900"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Blue Button Style -->
        <Style Selector="Button.blue">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.blue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2980B9"/>
        </Style>
        <Style Selector="Button.blue:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#21618C"/>
        </Style>

        <!-- Green Button Style -->
        <Style Selector="Button.green">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#229954"/>
        </Style>
        <Style Selector="Button.green:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E8449"/>
        </Style>

        <!-- Orange Button Style -->
        <Style Selector="Button.orange">
            <Setter Property="Background" Value="#E67E22"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.orange:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D35400"/>
        </Style>
        <Style Selector="Button.orange:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#BA4A00"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,*">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#F5F5F5" 
                Padding="20" 
                CornerRadius="8"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Win32 to Intune Package Creator" 
                               FontSize="24" 
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="Create .intunewin packages for Microsoft Intune deployment" 
                               FontSize="14" 
                               Foreground="#7F8C8D"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToolStatus}" 
                               FontSize="12" 
                               FontWeight="Medium"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    Padding="0">
            
            <!-- Single Package Tab -->
            <TabItem Header="Single Package">
                <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="20">
                
                <!-- Source Folder Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Source Folder *" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="The folder containing all your application files" 
                                   FontSize="12" 
                                   Foreground="#7F8C8D"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SourceFolder}"
                                     Watermark="Select source folder..."
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" 
                                    Content="Browse..."
                                    Command="{Binding BrowseSourceFolderCommand}"
                                    Width="100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Setup File Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Setup File *" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="The installer executable (e.g., setup.exe, install.msi)" 
                                   FontSize="12" 
                                   Foreground="#7F8C8D"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SetupFile}"
                                     Watermark="Select setup file..."
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" 
                                    Content="Browse..."
                                    Command="{Binding BrowseSetupFileCommand}"
                                    Width="100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Output Folder Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output Folder *" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="Where the .intunewin package will be saved" 
                                   FontSize="12" 
                                   Foreground="#7F8C8D"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding OutputFolder}"
                                     Watermark="Select output folder..."
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" 
                                    Content="Browse..."
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Width="100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Catalog Folder Section (Optional) -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Catalog Folder (Optional)" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="Folder containing the catalog files for the Win32 app" 
                                   FontSize="12" 
                                   Foreground="#7F8C8D"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding CatalogFolder}"
                                     Watermark="Select catalog folder (optional)..."
                                     Margin="0,0,10,0"/>
                            <Button Grid.Column="1" 
                                    Content="Browse..."
                                    Command="{Binding BrowseCatalogFolderCommand}"
                                    Width="100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20"
                        IsVisible="{Binding IsProgressVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Progress" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <ProgressBar Value="{Binding ProgressValue}" 
                                     Height="8"
                                     Foreground="#3498DB"
                                     Minimum="0" 
                                     Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- Log Output Section -->
                <Border Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Output Log" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"
                                   Foreground="#2C3E50"/>
                        <Border Background="#F8F9FA" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                Height="200">
                            <ScrollViewer>
                                <TextBox Text="{Binding LogOutput}"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Consolas,Monaco,Courier New"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons for Single Mode -->
        <Border Grid.Row="1" 
                Background="#F5F5F5" 
                Padding="20" 
                CornerRadius="8"
                Margin="0,20,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" 
                           Text="* Required fields" 
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#7F8C8D"/>
                <Button Grid.Column="1" 
                        Content="Upload to Intune"
                        Classes="green"
                        Command="{Binding UploadSinglePackageCommand}"
                        FontWeight="SemiBold"
                        Padding="20,12"
                        CornerRadius="6"
                        FontSize="14"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding !IsProcessing}"/>
                <Button Grid.Column="2" 
                        Content="Create Package"
                        Classes="blue"
                        Command="{Binding CreatePackageCommand}"
                        FontWeight="SemiBold"
                        Padding="30,12"
                        CornerRadius="6"
                        FontSize="14"
                        IsEnabled="{Binding !IsProcessing}"/>
            </Grid>
        </Border>
                </Grid>
            </TabItem>
            
            <!-- Batch Processing Tab -->
            <TabItem Header="Batch Processing">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    
                    <!-- Instructions -->
                    <Border Grid.Row="0"
                            Background="#E8F4F8" 
                            BorderBrush="#3498DB" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="15"
                            Margin="0,0,0,20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Batch Processing Workflow:" 
                                       FontWeight="SemiBold" 
                                       FontSize="13"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="1. Select the parent folder containing your application subfolders" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="2. Click 'Scan Folders' - a review dialog will appear" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="3. In the dialog, manually select installers for items that need attention or skip them" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="4. Close the dialog, then select the output folder where packages will be saved" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                            <TextBlock Text="5. Click 'Process Batch' to create all packages" 
                                       FontSize="12" 
                                       Foreground="#34495E"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Batch Folder Selection -->
                    <Border Grid.Row="1"
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Step 1: Parent Folder" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Select a folder containing subfolders with applications to package" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"/>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding BatchParentFolder}"
                                         Watermark="Select parent folder containing app subfolders..."
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..."
                                        Command="{Binding BrowseBatchFolderCommand}"
                                        Width="100"
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="2" 
                                        Content="Step 2: Scan Folders"
                                        Classes="green"
                                        Command="{Binding ScanBatchFoldersCommand}"
                                        FontWeight="SemiBold"
                                        Width="150"
                                        IsEnabled="{Binding !IsProcessing}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Batch Output Folder -->
                    <Border Grid.Row="2"
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Step 4: Output Folder" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Where all .intunewin packages will be saved" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" 
                                         Text="{Binding BatchOutputFolder}"
                                         Watermark="Select output folder for batch packages..."
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..."
                                        Command="{Binding BrowseBatchOutputFolderCommand}"
                                        Width="100"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Log Output Section -->
                    <Border Grid.Row="3"
                            Background="White" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Batch Processing Log" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="#2C3E50"/>
                            <Border Background="#F8F9FA" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    Height="200">
                                <ScrollViewer>
                                    <TextBox Text="{Binding LogOutput}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Consolas,Monaco,Courier New"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Batch Action Buttons -->
                    <Border Grid.Row="4" 
                            Background="#F5F5F5" 
                            Padding="20" 
                            CornerRadius="8"
                            Margin="0,20,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding BatchStatusText}" 
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <Button Grid.Column="1" 
                                    Content="Upload to Intune"
                                    Classes="blue"
                                    Command="{Binding ShowIntuneUploadDialogCommand}"
                                    FontWeight="SemiBold"
                                    Padding="30,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    Margin="0,0,10,0"
                                    IsEnabled="{Binding !IsProcessing}"/>
                            <Button Grid.Column="2" 
                                    Content="Step 5: Process Batch"
                                    Classes="orange"
                                    Command="{Binding ProcessBatchCommand}"
                                    FontWeight="SemiBold"
                                    Padding="30,12"
                                    CornerRadius="6"
                                    FontSize="14"
                                    IsEnabled="{Binding !IsProcessing}"/>
                        </Grid>
                    </Border>
                    
                </Grid>
            </TabItem>
            
        </TabControl>
        
    </Grid>

</Window>
