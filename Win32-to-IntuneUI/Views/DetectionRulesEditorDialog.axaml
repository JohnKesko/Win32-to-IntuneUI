<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Win32_to_IntuneUI.Views"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
        x:Class="Win32_to_IntuneUI.Views.DetectionRulesEditorDialog"
        Title="Detection Rules"
        Width="850" Height="550"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button.blue">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.blue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2980B9"/>
        </Style>
        
        <Style Selector="Button.green">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.green:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#229954"/>
        </Style>
        
        <Style Selector="Button.red">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.red:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        
        <Style Selector="Button.gray">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.gray:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#7F8C8D"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <TextBlock Text="Detection Rules" 
                       FontSize="18" 
                       FontWeight="Bold"/>
            <TextBlock x:Name="AppNameText"
                       Text=""
                       Foreground="Gray"/>
            <TextBlock Text="Configure how Intune detects if this application is installed."
                       Foreground="Gray"
                       FontSize="12"/>
        </StackPanel>

        <!-- Rules List and Editor -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*">
            <!-- Rules List -->
            <Border Grid.Column="0" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" 
                               Text="Rules" 
                               FontWeight="SemiBold"
                               Padding="10"
                               Background="#F8F9FA"/>
                    
                    <ListBox x:Name="RulesListBox"
                             Grid.Row="1"
                             SelectionChanged="RulesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DetectionRuleViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                Spacing="5" 
                                Margin="5"
                                HorizontalAlignment="Center">
                        <Button x:Name="AddRuleButton" 
                                Content="Add" 
                                Classes="green"
                                Click="AddRule_Click"
                                Width="70"/>
                        <Button x:Name="RemoveRuleButton" 
                                Content="Remove" 
                                Classes="red"
                                Click="RemoveRule_Click"
                                Width="80"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rule Editor -->
            <Border Grid.Column="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <ScrollViewer>
                    <StackPanel x:Name="RuleEditorPanel" Spacing="12" Margin="15">
                        <!-- Rule Type -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Rule Type" FontWeight="SemiBold"/>
                            <ComboBox x:Name="RuleTypeCombo" 
                                      SelectedIndex="0"
                                      SelectionChanged="RuleType_SelectionChanged"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Registry" Tag="registry"/>
                                <ComboBoxItem Content="File/Folder" Tag="file"/>
                                <ComboBoxItem Content="MSI Product Code" Tag="msi"/>
                                <ComboBoxItem Content="PowerShell Script" Tag="script"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Registry Detection Fields -->
                        <StackPanel x:Name="RegistryPanel" Spacing="8" IsVisible="True">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Registry Hive"/>
                                <ComboBox x:Name="RegistryHiveCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="HKEY_LOCAL_MACHINE" Tag="localMachine"/>
                                    <ComboBoxItem Content="HKEY_CURRENT_USER" Tag="currentUser"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Key Path"/>
                                <TextBox x:Name="RegistryKeyPathBox" 
                                         Watermark="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{GUID}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Value Name (optional)"/>
                                <TextBox x:Name="RegistryValueNameBox" 
                                         Watermark="Leave empty to check key existence"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Detection Method"/>
                                <ComboBox x:Name="RegistryDetectionMethodCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Key/Value Exists" Tag="exists"/>
                                    <ComboBoxItem Content="Key/Value Does Not Exist" Tag="notExists"/>
                                    <ComboBoxItem Content="String Comparison" Tag="string"/>
                                    <ComboBoxItem Content="Integer Comparison" Tag="integer"/>
                                    <ComboBoxItem Content="Version Comparison" Tag="version"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="RegistryValuePanel" Spacing="4" IsVisible="False">
                                <TextBlock Text="Operator"/>
                                <ComboBox x:Name="RegistryOperatorCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Equals" Tag="equal"/>
                                    <ComboBoxItem Content="Not Equals" Tag="notEqual"/>
                                    <ComboBoxItem Content="Greater Than" Tag="greaterThan"/>
                                    <ComboBoxItem Content="Greater Than or Equal" Tag="greaterThanOrEqual"/>
                                    <ComboBoxItem Content="Less Than" Tag="lessThan"/>
                                    <ComboBoxItem Content="Less Than or Equal" Tag="lessThanOrEqual"/>
                                </ComboBox>
                                <TextBlock Text="Expected Value" Margin="0,8,0,0"/>
                                <TextBox x:Name="RegistryExpectedValueBox"/>
                            </StackPanel>
                            <CheckBox x:Name="Registry32BitCheckBox" 
                                      Content="Check 32-bit registry on 64-bit systems"/>
                        </StackPanel>

                        <!-- File Detection Fields -->
                        <StackPanel x:Name="FilePanel" Spacing="8" IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Path"/>
                                <TextBox x:Name="FilePathBox" 
                                         Watermark="%ProgramFiles%\MyApp"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="File or Folder Name"/>
                                <TextBox x:Name="FileNameBox" 
                                         Watermark="app.exe"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Detection Method"/>
                                <ComboBox x:Name="FileDetectionMethodCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="File/Folder Exists" Tag="exists"/>
                                    <ComboBoxItem Content="File/Folder Does Not Exist" Tag="notExists"/>
                                    <ComboBoxItem Content="Version Comparison" Tag="version"/>
                                    <ComboBoxItem Content="Date Modified" Tag="dateModified"/>
                                    <ComboBoxItem Content="Date Created" Tag="dateCreated"/>
                                    <ComboBoxItem Content="Size (MB)" Tag="sizeInMB"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="File32BitCheckBox" 
                                      Content="Check 32-bit location on 64-bit systems"/>
                        </StackPanel>

                        <!-- MSI Detection Fields -->
                        <StackPanel x:Name="MsiPanel" Spacing="8" IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="MSI Product Code"/>
                                <TextBox x:Name="MsiProductCodeBox" 
                                         Watermark="Example: 12345678-1234-1234-1234-123456789012"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Version Operator (optional)"/>
                                <ComboBox x:Name="MsiVersionOperatorCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Not Configured" Tag="notConfigured"/>
                                    <ComboBoxItem Content="Equals" Tag="equal"/>
                                    <ComboBoxItem Content="Not Equals" Tag="notEqual"/>
                                    <ComboBoxItem Content="Greater Than" Tag="greaterThan"/>
                                    <ComboBoxItem Content="Greater Than or Equal" Tag="greaterThanOrEqual"/>
                                    <ComboBoxItem Content="Less Than" Tag="lessThan"/>
                                    <ComboBoxItem Content="Less Than or Equal" Tag="lessThanOrEqual"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Product Version (optional)"/>
                                <TextBox x:Name="MsiVersionBox" 
                                         Watermark="1.0.0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Script Detection Fields -->
                        <StackPanel x:Name="ScriptPanel" Spacing="8" IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PowerShell Script"/>
                                <TextBox x:Name="ScriptContentBox" 
                                         AcceptsReturn="True"
                                         Height="150"
                                         TextWrapping="Wrap"
                                         Watermark="# Exit code 0 = detected&#x0a;if (Test-Path 'C:\Program Files\MyApp') { exit 0 } else { exit 1 }"/>
                            </StackPanel>
                            <CheckBox x:Name="ScriptRunAs32BitCheckBox" 
                                      Content="Run as 32-bit process on 64-bit hosts"/>
                            <CheckBox x:Name="ScriptEnforceSignatureCheckBox" 
                                      Content="Enforce script signature check"/>
                        </StackPanel>

                        <!-- Apply to current rule button -->
                        <Button x:Name="ApplyRuleButton"
                                Content="Apply Changes"
                                Classes="blue"
                                Click="ApplyRule_Click"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10"
                    Margin="0,15,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Classes="gray"
                    Click="Cancel_Click"
                    Width="100"/>
            <Button x:Name="SaveButton"
                    Content="Save"
                    Classes="blue"
                    Click="Save_Click"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
